x2:"18",y2:"10"},child:[]},{tag:"line",attr:{x1:"12",y1:"20",x2:"12",y2:"4"},child:[]},{tag:"line",attr:{x1:"6",y1:"20",x2:"6",y2:"14"},child:[]}]})(e)}const oS={"01":{client:"Leading industrial facility operator",challenge:"The client operated a large-scale manufacturing facility spanning 50,000 sq. ft. with persistent thermal hotspots and inconsistent airflow distribution. Traditional HVAC design had led to 30% energy waste and worker discomfort in critical production zones.",approach:["Transient thermal analysis capturing heat generation from 120+ machinery units","Multi-zone airflow mapping with k-ε turbulence modeling","Parametric optimization of diffuser placement and duct sizing","Conjugate heat transfer analysis for wall and roof assemblies"],results:["38% reduction in HVAC energy consumption","Uniform temperature distribution within ±1.5°C across all zones","ROI achieved within 14 months of implementation","Improved air quality index by 45% in worker-occupied areas"],technologies:"ANSYS Fluent, STAR-CCM+, OpenFOAM, Python scripting for post-processing"},"02":{client:"Tier-1 aerospace manufacturer",challenge:"The client sought to reduce fuel consumption on a next-generation regional aircraft by optimizing the wing-body fairing and nacelle integration. Wind tunnel testing alone was insufficient to explore the full design space within the project timeline.",approach:["Full-aircraft RANS simulations at cruise and off-design conditions","Mesh refinement studies with 80M+ cell hybrid meshes","Drag decomposition to isolate pressure, friction, and interference drag","Shape optimization using adjoint-based methods for fairing geometry","Flutter and aeroelastic coupling assessment at critical flight envelopes"],results:["4.2% drag reduction on the wing-body junction","2.8% improvement in overall fuel efficiency at cruise Mach","Design cycle time reduced by 60% compared to wind tunnel iterations","3 optimal configurations delivered for prototype testing"],technologies:"ANSYS Fluent, CFX, Pointwise meshing, MATLAB for optimization loops, HPC cluster (2048 cores)"},"03":{client:"Major upstream oil & gas operator",challenge:"The client faced recurring wax deposition and hydrate formation issues in a 45 km subsea tieback, leading to production downtime costing $2M+ per incident. Existing flow assurance models lacked the fidelity to predict deposition patterns accurately.",approach:["Multiphase flow modeling (oil-gas-water) with PVT-calibrated fluid properties","Thermal-hydraulic analysis of the entire pipeline network","Wax deposition kinetics using molecular diffusion and shear removal models","Hydrate risk mapping across seasonal seabed temperature variations","Pigging simulation to optimize cleaning schedules and pig selection"],results:["90% prediction accuracy for wax deposition locations vs. field data","$4.5M annual savings from optimized pigging and chemical injection","Zero unplanned shutdowns in the first 18 months post-implementation","Reduced chemical usage by 35% through targeted injection strategy"],technologies:"OLGA, ANSYS Fluent, PVTsim, Python-based workflow automation, custom deposition UDFs"},"04":{client:"Global EV manufacturer",challenge:"The client's next-generation EV battery pack experienced thermal runaway risks during fast charging and high-performance driving. The existing cooling system design could not maintain cell temperatures within the safe operating window (15–35°C) under all conditions.",approach:["Cell-level electrochemical-thermal modeling with equivalent circuit models","Pack-level conjugate heat transfer simulation with coolant flow optimization","Thermal runaway propagation analysis per EUCAR hazard levels","Cold-start performance modeling at –20°C ambient conditions","Design of experiments (DOE) for cooling plate geometry optimization"],results:["Peak cell temperature reduced by 12°C during fast charging","Thermal uniformity improved to ΔT < 3°C across all modules","15% improvement in battery cycle life projections","Thermal runaway propagation contained within single module"],technologies:"ANSYS Fluent, STAR-CCM+, GT-SUITE for 1D-3D coupling, MATLAB Simulink, CATIA V5"},"05":{client:"International airport authority",challenge:"A major international airport terminal expansion required validation of fire safety and evacuation strategies for a new 85,000 sq. m. concourse accommodating 15,000+ occupants. Regulatory approval demanded performance-based fire engineering evidence beyond prescriptive code compliance.",approach:["FDS fire simulations for 12 design fire scenarios (retail, lounge, baggage)","Smoke layer analysis with visibility, temperature, and toxicity criteria","Smoke management system optimization — jet fans, extraction rates, make-up air","Agent-based evacuation modeling using Pathfinder with 15,000+ occupant profiles","Tenability assessment per BS 7974 and NFPA 92 standards"],results:["All 12 scenarios passed ASET > RSET criteria with safety margins > 2 min","Smoke extraction redesign saved $1.2M in mechanical system costs","Evacuation time reduced by 22% through optimized exit signage placement","Full regulatory approval obtained on first submission"],technologies:"FDS 6, Smokeview, Pathfinder, PyroSim, AutoCAD for geometry preparation, custom Python post-processing"},"06":{client:"Premium automotive OEM",challenge:"The client needed to validate a lightweight aluminum suspension knuckle design against durability and crash load requirements while achieving a 25% mass reduction versus the incumbent cast iron component. Physical prototype testing was cost-prohibitive for early design iterations.",approach:["Linear and nonlinear FEA under 18 static and quasi-static load cases","Fatigue life prediction using strain-life approach with multiaxial corrections","Topology optimization to identify material-efficient load paths","Crash impact simulation at 56 km/h frontal and 32 km/h side impact","Manufacturing feasibility assessment for high-pressure die casting constraints"],results:["28% mass reduction achieved (exceeding the 25% target)","Fatigue life exceeded 300,000 cycles at all critical locations","All crash load cases passed with safety factors > 1.4","2 design iterations saved vs. traditional build-test-fix approach"],technologies:"ANSYS Mechanical, LS-DYNA, HyperMesh, OptiStruct for topology optimization, nCode DesignLife"}},sS=[{num:"01",discipline:"CFD",title:"CFD for HVAC Optimization",sector:"Industrial",focus:"Climate Control",imgUrl:"/images/portfolio-1.jpg",fallback:"linear-gradient(135deg, #101724 0%, #05070c 58%, #172030 100%)"},{num:"02",discipline:"CFD",title:"Aerospace CFD Analysis",sector:"Aerospace",focus:"Fuel Efficiency",imgUrl:"/images/portfolio-2.jpg",fallback:"linear-gradient(145deg, #0c111b 0%, #151d2b 52%, #05070c 100%)"},{num:"03",discipline:"CFD",title:"Oil & Gas Flow Simulation",sector:"Energy",focus:"Flow Assurance",imgUrl:"/images/portfolio-3.jpg",fallback:"radial-gradient(circle at 72% 72%, rgba(93,107,136,0.42), transparent 30%), #080c13"},{num:"04",discipline:"CAE",title:"Automotive Thermal Management",sector:"Automotive",focus:"Battery Life",imgUrl:"/images/portfolio-4.jpg",fallback:"linear-gradient(160deg, #151b27 0%, #05070c 70%)"},{num:"05",discipline:"FDS",title:"Fire & Smoke Simulation",sector:"Safety",focus:"Evacuation",imgUrl:"/images/portfolio-5.jpg",fallback:"linear-gradient(90deg, #1a0e0a, #2a1208)"},{num:"06",discipline:"CAE",title:"CAE Stress Analysis",sector:"Automotive",focus:"Structural Integrity",imgUrl:"/images/portfolio-6.jpg",fallback:"linear-gradient(140deg, #05070c 0%, #121a27 100%)"}];function aS({project:e}){const[t,n]=E.useState(!1);return m.jsxs("div",{style:{position:"relative",height:310,borderBottom:"1px solid var(--rule)",overflow:"hidden"},children:[e.imgUrl&&!t?m.jsx("img",{src:e.imgUrl,alt:e.title,onError:()=>n(!0),style:{position:"absolute",inset:0,width:"100%",height:"100%",objectFit:"cover"}}):m.jsx("div",{style:{position:"absolute",inse